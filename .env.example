# Vercel Environment Variables for Form Email Delivery
# Add these variables in Vercel Dashboard -> Project Settings -> Environment Variables

# The email address used to send out emails (Gmail or SMTP email)
EMAIL_USER=your-email@gmail.com

# 16-character Gmail App Password (generated from Google Account Security settings)
EMAIL_PASS=xxxx xxxx xxxx xxxx

# (Optional) The email address where form submissions should be received.
# If omitted, EMAIL_USER will be used as the recipient.
EMAIL_TO=your-email@gmail.com
